# Private documents of the editors Retrolarium replaced
/content/workspace/

# Python
__pycache__/
*.pyc

# OS/editor
.DS_Store
Thumbs.db

/hacks/local/

# Retrolarium Studio: the generated project, builds and caches, and the edits
