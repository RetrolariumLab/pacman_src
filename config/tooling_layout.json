    {"name": "ui-smoke", "path": "scripts/authoring/ui_smoke.py", "test_owner": "tests/authoring/test_ui_smoke.py"},
    {"name": "verify-expanded", "path": "scripts/validation/verify_expanded.py", "test_owner": "tests/validation/test_verify_expanded.py"},
