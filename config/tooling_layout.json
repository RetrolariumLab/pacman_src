{
  "schema_version": 1,
  "stable_launcher": "scripts/run.py",
  "scripts_root": "scripts",
  "tests_root": "tests",
  "python_review_threshold": 700,
  "size_exceptions": [
    {
      "path": "scripts/validation/source_2_2_audit.py",
      "threshold": 700,
      "reason": "The release validator is intentionally an ordered, self-contained evaluation of one manifest, so shared error aggregation and gate state remain visible in one review surface.",
      "cohesion": "Parsing, repository inspection, and requirement checks all feed the single audit result; GUI, build, and capture behavior remain outside this module.",
      "split_decision": "Split reusable validators into a validation package only when a later release line has a second consumer; doing so inside 2.2 would add import-path churn to the release gate."
    },
    {
      "path": "scripts/workflow/compare_progress_capture.py",
      "threshold": 700,
      "reason": "This legacy non-release workflow emits one coupled comparison report across aligned frame images, memory snapshots, ASCII screens, sprites, and summary tables.",
      "cohesion": "All parsers and formatters serve one command and share its frame-offset and report-order contract; production build and validation code do not import it.",
      "split_decision": "Keep the workflow atomic until its report formats gain independent consumers and focused tests that can support a compatible extraction."
    }
  ],
  "responsibilities": [
    {
      "id": "build",
      "paths": [
