        "tests/authoring/test_graphics_studio.py",
        "tests/authoring/test_maze_studio.py",
        "tests/authoring/test_midi_to_sound.py",
        "tests/authoring/test_screen_studio.py",
        "tests/authoring/test_sound_authoring.py",
        "tests/authoring/test_sound_preview.py",
        "tests/authoring/test_sound_studio.py",
        "tests/authoring/test_ui_smoke.py"
