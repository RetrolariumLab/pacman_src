  "delta": [
    {
      "id": "retrolarium-descriptor",
      "kind": "tooling",
      "summary": "pacman.rlj names the game, its profile pacman.v1, the revisions it builds and its asset split; the studio views come from the kit."
    },
    {
      "id": "editing-moves-to-retrolarium",
      "kind": "tooling",
      "summary": "The editors, their models, the workspace composer, the UI smokes and their tests, Make targets and documentation are removed; editing happens in Retrolarium Studio over hack/<revision>/ (docs/retrolarium.md)."
    },
    {
      "id": "studio-check",
      "kind": "validation",
      "summary": "make studio-check: in a throwaway copy the kit prepares, validates and rebuilds every revision with no edits, byte for byte."
    },
    {
      "id": "tag-bound-2x-audits",
      "kind": "validation",
      "summary": "The 2.x manifests describe their tags' trees, so their audits run at the tag in a disposable clone; the functional 2.x gate stays on HEAD."
    },
    {
      "id": "expanded-revision",
      "kind": "tooling",
      "summary": "The expanded NROM-256 variant is the built revision japan-v10-nrom256; scripts/build/ owns the codecs its build needs."
    },
    {
      "id": "object-names",
      "kind": "source",
      "summary": "The third ghost's attract packets are named for KIMAGURE and AOSUKE (Tengen spells INKY there), the ghost slots get constants by character, and the fruit tables name their fruit."
    },
    {
      "id": "kit-toolchain",
      "kind": "toolchain",
      "summary": "The repository no longer carries ca65 and ld65: the build asks Retrolarium Kit for the cc65 it builds and ships (the same 2.19 0fca835, pinned by size and SHA-256 in config/toolchain.json), and bin/ is gone."
    },
    {
      "id": "shared-linter",
      "kind": "tooling",
      "summary": "make lint and make format run Retrolarium Kit's shared linter (rltool lint) over config/lint.json: the ca65 style for src and the text contract; asm_style.py and its tests move to the kit. lint_source and the documentation audit stay here."
    },
    {
      "id": "game-names",
      "kind": "tooling",
      "summary": "config/names.json keeps the game's own names, in English, and the lists that carry them; Retrolarium Studio and Kit read them when a project opens and keep none themselves. Its guard list names what Retrolarium's repositories must never contain."
    },
    {
      "id": "game-profile",
      "kind": "tooling",
      "summary": "config/game_profile.json is the game's Retrolarium profile: its revisions with their hashes and where each resource lies in each image. Retrolarium Kit reads it when it opens the repository and keeps no copy."
    },
    {
      "id": "profile-tables",
      "kind": "tooling",
      "summary": "config/profile_tables.json names by label the tables Retrolarium Kit reads from the image built from this source; the kit's tools/profile_tables.py turns it into profile offsets."
    }
  ],
