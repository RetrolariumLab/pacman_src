  "reader_journeys": [
    {
      "id": "build_and_verify",
      "paths": ["README.md", "docs/validation.md", "docs/source_reconstruction_2_2.md"]
    },
    {
      "id": "change_source",
      "paths": ["docs/source_layout.md", "docs/naming.md", "docs/assembly_style.md", "docs/unknowns.md"]
    },
    {
      "id": "author_content",
      "paths": ["docs/data_formats.md", "docs/expanded_rom_assets.md", "docs/ui_smoke.md"]
    },
    {
      "id": "review_provenance",
      "paths": ["docs/licensing.md", "docs/provenance/README.md", "docs/nesdev/README.md"]
    }
  ],
  "size_policy": {
    "recommended_max_lines": 600,
    "exceptions": [
      {
        "path": "docs/roadmap.md",
        "reason": "The roadmap is a chronological planning and completed-milestone ledger whose ordering would be obscured by mechanical splitting."
      }
    ]
  },
  "prefix_policy": {
    "minimum_cluster_size": 3,
    "exceptions": [
      {
        "prefix": "source_reconstruction",
        "reason": "Each release document is a stable record with its own version boundary and lifecycle."
      }
    ]
  },
  "vendored_boundary": {
    "root": "docs/nesdev",
    "policy": "docs/nesdev/README.md",
    "documents": [
