; Flags derived from PACMAN_REVISION for the code that differs by revision

.assert PACMAN_REVISION >= REVISION_JAPAN_V10, error, "invalid Pac-Man revision"
.assert PACMAN_REVISION <= REVISION_EUROPE, error, "invalid Pac-Man revision"

.if PACMAN_REVISION = REVISION_USA_TENGEN_UNLICENSED
PACMAN_REVISION_TENGEN = 1
PACMAN_REVISION_RAM_PALETTES = 1
.elseif PACMAN_REVISION = REVISION_USA_TENGEN_LICENSED
PACMAN_REVISION_TENGEN = 1
PACMAN_REVISION_RAM_PALETTES = 1
.elseif PACMAN_REVISION = REVISION_JAPAN_REVB
PACMAN_REVISION_RAM_PALETTES = 1
.elseif PACMAN_REVISION = REVISION_USA_NAMCO
PACMAN_REVISION_RAM_PALETTES = 1
.elseif PACMAN_REVISION = REVISION_EUROPE
PACMAN_REVISION_RAM_PALETTES = 1
.endif

.if PACMAN_REVISION = REVISION_USA_NAMCO .or PACMAN_REVISION = REVISION_EUROPE
PACMAN_REVISION_LATE_NAMCO = 1
.endif
