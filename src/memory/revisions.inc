; Official ROM revision profiles.
; Keep the preservation source on Japan V1.0 unless an entrypoint explicitly
; selects another profile before including main.asm.

REVISION_JAPAN_V10 = 0
REVISION_JAPAN_V11 = 1
REVISION_USA_TENGEN_UNLICENSED = 2
REVISION_USA_TENGEN_LICENSED = 3
REVISION_JAPAN_REVB = 4
REVISION_USA_NAMCO = 5

.ifndef PACMAN_REVISION
PACMAN_REVISION = REVISION_JAPAN_V10
.endif

.assert PACMAN_REVISION >= REVISION_JAPAN_V10, error, "invalid Pac-Man revision"
.assert PACMAN_REVISION <= REVISION_USA_NAMCO, error, "invalid Pac-Man revision"

.if PACMAN_REVISION = REVISION_USA_TENGEN_UNLICENSED
PACMAN_REVISION_TENGEN = 1
PACMAN_REVISION_RAM_PALETTES = 1
.elseif PACMAN_REVISION = REVISION_USA_TENGEN_LICENSED
PACMAN_REVISION_TENGEN = 1
PACMAN_REVISION_RAM_PALETTES = 1
.elseif PACMAN_REVISION = REVISION_JAPAN_REVB
PACMAN_REVISION_RAM_PALETTES = 1
.elseif PACMAN_REVISION = REVISION_USA_NAMCO
PACMAN_REVISION_RAM_PALETTES = 1
.endif
